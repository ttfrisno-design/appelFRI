<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      background: #F1F5F3;
      margin: 0;
      padding: 16px;
      color: #1B4332;
    }
    .ecran { display: none; max-width: 480px; margin: 0 auto; }
    .ecran.actif { display: block; }
    h1 {
      font-size: 20px;
      text-align: center;
      color: #1B4332;
      margin-bottom: 24px;
    }
    .carte {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
      margin-bottom: 12px;
    }
    input[type="tel"], input[type="password"] {
      width: 100%;
      font-size: 24px;
      text-align: center;
      letter-spacing: 8px;
      padding: 14px;
      border: 2px solid #40916C;
      border-radius: 8px;
      margin-bottom: 16px;
    }
    button {
      width: 100%;
      font-size: 16px;
      font-weight: bold;
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: #2D6A4F;
      color: white;
      cursor: pointer;
    }
    button:disabled { background: #A0AEC0; }
    button.secondaire {
      background: white;
      color: #2D6A4F;
      border: 2px solid #2D6A4F;
      margin-top: 8px;
    }
    .erreur {
      color: #C0392B;
      text-align: center;
      margin-bottom: 12px;
      font-size: 14px;
      min-height: 18px;
    }
    .creneau-item, .date-item {
      display: block;
      width: 100%;
      text-align: left;
      background: white;
      border: 2px solid #E2E8F0;
      border-radius: 8px;
      padding: 14px;
      margin-bottom: 10px;
      cursor: pointer;
      font-size: 15px;
    }
    .creneau-item b, .date-item b { color: #1B4332; }
    .membre-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: white;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 8px;
    }
    .membre-nom { font-size: 15px; }
    .toggle {
      display: flex;
      border-radius: 20px;
      overflow: hidden;
      border: 2px solid #E2E8F0;
    }
    .toggle button {
      width: auto;
      padding: 8px 16px;
      font-size: 13px;
      border-radius: 0;
      background: white;
      color: #718096;
    }
    .toggle button.on-present { background: #40916C; color: white; }
    .toggle button.on-absent { background: #C0392B; color: white; }
    .entete-creneau {
      text-align: center;
      margin-bottom: 16px;
      font-size: 14px;
      color: #40916C;
    }
    .lien-retour {
      text-align: center;
      display: block;
      margin-top: 16px;
      color: #40916C;
      cursor: pointer;
      font-size: 14px;
    }
    .confirmation {
      text-align: center;
      padding: 40px 20px;
    }
    .confirmation .coche {
      font-size: 48px;
      margin-bottom: 16px;
    }
  </style>
</head>
<body>

  <h1>📋 Appel FRI</h1>

  <!-- Écran 1 : PIN -->
  <div id="ecran-pin" class="ecran actif">
    <div class="carte">
      <div class="erreur" id="erreur-pin"></div>
      <input type="tel" id="input-pin" maxlength="6" placeholder="------" inputmode="numeric">
      <button id="btn-connecter" onclick="connecter()">Se connecter</button>
    </div>
  </div>

  <!-- Écran 2 : liste des créneaux -->
  <div id="ecran-creneaux" class="ecran">
    <div class="entete-creneau" id="bonjour-animateur"></div>
    <div id="liste-creneaux"></div>
  </div>

  <!-- Écran 3 : liste des dates -->
  <div id="ecran-dates" class="ecran">
    <div class="entete-creneau" id="titre-creneau-dates"></div>
    <div id="liste-dates"></div>
    <span class="lien-retour" onclick="retourCreneaux()">‹ Retour aux créneaux</span>
  </div>

  <!-- Écran 4 : appel -->
  <div id="ecran-appel" class="ecran">
    <div class="entete-creneau" id="titre-creneau-appel"></div>
    <div id="liste-membres"></div>
    <button id="btn-valider" onclick="validerAppel()">Valider l'appel</button>
    <span class="lien-retour" onclick="retourDates()">‹ Changer de date</span>
  </div>

  <!-- Écran 5 : confirmation -->
  <div id="ecran-confirmation" class="ecran">
    <div class="carte confirmation">
      <div class="coche">✅</div>
      <div id="texte-confirmation"></div>
      <button class="secondaire" onclick="retourCreneaux()">Faire un autre appel</button>
    </div>
  </div>

  <script>
    var etat = { pin: null, animateur: null, code: null, colonne: null, membres: [] };

    function afficherEcran(id) {
      document.querySelectorAll('.ecran').forEach(function(e) { e.classList.remove('actif'); });
      document.getElementById(id).classList.add('actif');
    }

    // ── Écran 1 : connexion ──
    document.getElementById('input-pin').addEventListener('keyup', function(e) {
      if (e.key === 'Enter') connecter();
    });

    function connecter() {
      var pin = document.getElementById('input-pin').value.trim();
      document.getElementById('erreur-pin').textContent = '';
      if (!/^\d{6}$/.test(pin)) {
        document.getElementById('erreur-pin').textContent = 'Le code doit contenir 6 chiffres.';
        return;
      }
      document.getElementById('btn-connecter').disabled = true;
      google.script.run
        .withSuccessHandler(function(res) {
          document.getElementById('btn-connecter').disabled = false;
          if (!res.ok) {
            document.getElementById('erreur-pin').textContent = res.message;
            return;
          }
          etat.pin = pin;
          etat.animateur = res.animateur;
          chargerCreneaux();
        })
        .withFailureHandler(function(err) {
          document.getElementById('btn-connecter').disabled = false;
          document.getElementById('erreur-pin').textContent = 'Erreur : ' + err.message;
        })
        .connecter(pin);
    }

    // ── Écran 2 : créneaux ──
    function chargerCreneaux() {
      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.ok) { alert(res.message); return; }
          document.getElementById('bonjour-animateur').textContent = 'Bonjour ' + res.animateur;
          var liste = document.getElementById('liste-creneaux');
          liste.innerHTML = '';
          res.creneaux.forEach(function(c) {
            var div = document.createElement('div');
            div.className = 'creneau-item';
            div.innerHTML = '<b>' + c.activite + '</b><br>' + c.jour + ' ' + c.heure;
            div.onclick = function() { choisirCreneau(c); };
            liste.appendChild(div);
          });
          afficherEcran('ecran-creneaux');
        })
        .withFailureHandler(function(err) { alert('Erreur : ' + err.message); })
        .listerCreneaux(etat.pin);
    }

    function retourCreneaux() {
      chargerCreneaux();
    }

    // ── Écran 3 : dates ──
    function choisirCreneau(c) {
      etat.code = c.code;
      document.getElementById('titre-creneau-dates').textContent = c.activite + ' — ' + c.jour + ' ' + c.heure;
      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.ok) { alert(res.message); return; }
          var liste = document.getElementById('liste-dates');
          liste.innerHTML = '';
          res.dates.forEach(function(d) {
            var div = document.createElement('div');
            div.className = 'date-item';
            div.innerHTML = (d.texte === res.aujourdhui ? '⭐ ' : '') + '<b>' + d.texte + '</b>';
            div.onclick = function() { choisirDate(d); };
            liste.appendChild(div);
          });
          afficherEcran('ecran-dates');
        })
        .withFailureHandler(function(err) { alert('Erreur : ' + err.message); })
        .listerDates(etat.pin, etat.code);
    }

    function retourDates() {
      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.ok) { alert(res.message); return; }
          var liste = document.getElementById('liste-dates');
          liste.innerHTML = '';
          res.dates.forEach(function(d) {
            var div = document.createElement('div');
            div.className = 'date-item';
            div.innerHTML = (d.texte === res.aujourdhui ? '⭐ ' : '') + '<b>' + d.texte + '</b>';
            div.onclick = function() { choisirDate(d); };
            liste.appendChild(div);
          });
          afficherEcran('ecran-dates');
        })
        .withFailureHandler(function(err) { alert('Erreur : ' + err.message); })
        .listerDates(etat.pin, etat.code);
    }

    // ── Écran 4 : appel ──
    function choisirDate(d) {
      etat.colonne = d.colonne;
      document.getElementById('titre-creneau-appel').textContent = d.texte;
      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.ok) { alert(res.message); return; }
          etat.membres = res.membres;
          var liste = document.getElementById('liste-membres');
          liste.innerHTML = '';
          res.membres.forEach(function(m) {
            var row = document.createElement('div');
            row.className = 'membre-row';
            var present = m.present === null ? 1 : m.present; // par défaut présent
            row.innerHTML =
              '<span class="membre-nom">' + m.prenom + ' ' + m.nom + '</span>' +
              '<span class="toggle" data-ligne="' + m.ligne + '">' +
              '<button type="button" class="btn-present">Présent</button>' +
              '<button type="button" class="btn-absent">Absent</button>' +
              '</span>';
            liste.appendChild(row);
            majToggle(row, present);
            row.querySelector('.btn-present').onclick = function() { majToggle(row, 1); };
            row.querySelector('.btn-absent').onclick = function() { majToggle(row, 0); };
          });
          afficherEcran('ecran-appel');
        })
        .withFailureHandler(function(err) { alert('Erreur : ' + err.message); })
        .listerMembres(etat.pin, etat.code, etat.colonne);
    }

    function majToggle(row, valeur) {
      row.dataset.valeur = valeur;
      row.querySelector('.btn-present').classList.toggle('on-present', valeur === 1);
      row.querySelector('.btn-absent').classList.toggle('on-absent', valeur === 0);
    }

    function validerAppel() {
      var presences = [];
      document.querySelectorAll('#liste-membres .membre-row').forEach(function(row) {
        presences.push({
          ligne: parseInt(row.querySelector('.toggle').dataset.ligne, 10),
          valeur: parseInt(row.dataset.valeur, 10)
        });
      });
      document.getElementById('btn-valider').disabled = true;
      google.script.run
        .withSuccessHandler(function(res) {
          document.getElementById('btn-valider').disabled = false;
          if (!res.ok) { alert(res.message); return; }
          document.getElementById('texte-confirmation').textContent =
            'Appel enregistré pour ' + res.nombre + ' adhérent(s).';
          afficherEcran('ecran-confirmation');
        })
        .withFailureHandler(function(err) {
          document.getElementById('btn-valider').disabled = false;
          alert('Erreur : ' + err.message);
        })
        .enregistrerAppel(etat.pin, etat.code, etat.colonne, presences);
    }
  </script>
</body>
</html>
